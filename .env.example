OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Opcional: trava única por aparelho. Sem ela, o app abre direto na escolha de perfil.
APP_PASSWORD=
# Opcional: controle de custo da IA
AI_DAILY_LIMIT=150
AI_PER_MINUTE=8
# String de conexão do Neon (a Vercel preenche sozinha ao conectar o Neon em Storage)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
